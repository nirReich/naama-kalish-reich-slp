# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/naama_slp?schema=public"

# OAuth credentials authorized for Naama's Google Calendar.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
GOOGLE_CALENDAR_ID="primary"

# Use the timezone configured for Naama's calendar.
CALENDAR_TIME_ZONE="Asia/Jerusalem"
BOOKING_DAYS="1,2,3,4,5"
BOOKING_OPEN_TIME="09:00"
BOOKING_CLOSE_TIME="17:00"
APPOINTMENT_DURATION_MINUTES="60"
APPOINTMENT_SLOT_INTERVAL_MINUTES="60"

# Replace with a long random value before running outside local development.
ADMIN_API_KEY="replace-with-a-long-random-secret"
FRONTEND_ORIGIN="http://localhost:3000"
PORT="3001"
